{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "share": "disabled",
  "enabled_providers": [
    "github-copilot"
  ],
  "formatter": false,
  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "clangd": {
      "command": ["clangd"],
      "extensions": [
        ".c",
        ".cpp",
        ".cc",
        ".cxx",
        ".c++",
        ".h",
        ".hpp",
        ".hh",
        ".hxx",
        ".h++"
      ]
    }
  },
  "permission": {
    "lsp": "allow"
  }
}
